# Copy to .env and fill in. NEVER commit .env.
# ---- Database ----
DATABASE_URL=postgresql+psycopg://designops:designops@localhost:5435/designops

# ---- Fairwind REST (OAuth2 client-credentials, §10) ----
# Rotate the leaked secret first (§9.6) and paste the NEW pair here.
FW_BASE_URL=https://fairwind.scandiweb.com
FW_CLIENT_ID=
FW_CLIENT_SECRET=
# Parallel account exports (daily mention pull + scripts). Default 8; poll every 2s.
# FW_EXPORT_CONCURRENCY=8
# FW_EXPORT_POLL_INTERVAL_S=2
# TEMPORARY: skip Fairwind on daily (CRO + Jira only). Set 0 to re-enable.
# DAILY_SKIP_FAIRWIND=1
# resource param audience-binds the JWT; MUST equal the server public URL (§10)
FW_RESOURCE=https://fairwind.scandiweb.com/api/v1
FW_SCOPE=api

# ---- Anthropic (synthesis) ----
ANTHROPIC_API_KEY=
# Latest, most capable model for the digest synthesis
DIGEST_MODEL=claude-opus-4-8

# ---- Jira Cloud (A3 weekly backlog — read-only) ----
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Hours used for overload / idle flags (Booked load vs normal week)
NORMAL_WEEK_HOURS=40

# ---- Tempo Cloud (VACSICK leave auto-detect for weekly backlog) ----
# Create at Tempo → Settings → API Integration (Bearer token).
TEMPO_API_TOKEN=
TEMPO_API_BASE=https://api.tempo.io/4

# Figma (OAuth app + personal access token) is configured in the UI:
# Config → Figma. Do not put FIGMA_* secrets here.

# ---- Pipeline behaviour ----
TIMEZONE=Europe/Riga
MIN_COVERAGE=0.6
# Object-store dir for cached raw export payloads {account_id}/{report_date}
CORPUS_STORE_DIR=./var/corpus

# ---- Delivery (all dormant in v1; go_live gate lives in the DB, not here) ----
GMAIL_SENDER=
OLGA_EMAIL=olga@scandiweb.com
SETUP_OWNER_EMAIL=liana.staskevica@scandiweb.com

# ---- Google OAuth (Gmail send + optional CRO mailbox read) ----
# Must match an Authorized redirect URI on the OAuth client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8077/oauth/google/callback
# Production (set on Railway → designops-app → Variables):
# PUBLIC_APP_URL=https://designops-app-production.up.railway.app
# GOOGLE_REDIRECT_URI=https://designops-app-production.up.railway.app/oauth/google/callback
# (If GOOGLE_REDIRECT_URI is omitted, PUBLIC_APP_URL or RAILWAY_PUBLIC_DOMAIN is used.)
# Separate Config connect (gmail.readonly) — only reads mail for this address:
CRO_MAILBOX_EMAIL=cro@scandiweb.com

# ---- Transcript app (call summary + weekly health last/next client call) ----
# Create a token in transcript-processor Settings → API tokens.
# Prefer scope TRANSCRIPTS (call-summary list/get). CALENDAR also works for both
# /api/transcripts and /api/calendar-meetings if you use one shared token.
TRANSCRIPT_API_BASE_URL=http://localhost:3001
TRANSCRIPT_API_TOKEN=

# ---- Notion (design intake generator) ----
# Internal integration secret from notion.so/my-integrations
NOTION_API_TOKEN=
# Parent page (inline Design projects table) or production database ID.
NOTION_PARENT_PAGE_ID=
# 1 = parent ID is a database. 0 = parent is a page (uses its inline table if present).
NOTION_PARENT_IS_DATABASE=0
