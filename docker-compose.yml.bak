# Local Postgres 16 for development. `docker compose up -d db`.
# Port 5433 on the host to avoid clashing with a system Postgres on 5432.
services:
  db:
    image: postgres:16
    environment:
      POSTGRES_USER: designops
      POSTGRES_PASSWORD: designops
      POSTGRES_DB: designops
    ports:
      - "5433:5432"
    volumes:
      - designops_pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U designops"]
      interval: 5s
      timeout: 5s
      retries: 10

volumes:
  designops_pgdata:
